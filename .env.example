PORT=3000
PASSWORD_PEPPER=replace-with-a-long-random-secret

# Brevo SMTP (free plan supports transactional email; daily limits apply)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login-email
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=Work Place <your-verified-sender-email>


# Work Place payments
# Bank transfer details shown to customers
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Work Place
BANK_ACCOUNT_NUMBER=Your Account Number
BANK_BRANCH=Your Branch
BANK_ROUTING=Your Routing Number

# SSLCOMMERZ sandbox/live settings
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
# Public URL of your deployed site, e.g. https://your-site.onrender.com
BASE_URL=http://localhost:3000


# Render Free online deployment
# Render Free blocks outbound SMTP ports 25/465/587. Use Brevo HTTPS API online.
BREVO_API_KEY=
